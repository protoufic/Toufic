{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist-ssr",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/entry-server.tsx",
    "src/pages/**/*.tsx",
    "src/components/**/*.tsx",
    "src/data/**/*.ts",
    "src/utils/contact.ts",
    "src/utils/cn.ts",
    "src/utils/preload.ts"
  ]
}
